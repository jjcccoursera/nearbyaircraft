[Unit]
Description=Gunicorn for nearbyaircraft
After=network.target

[Service]
User=admin
Group=www-data
WorkingDirectory=/home/admin/nearbyaircraft/backend
Environment="PATH=/home/admin/nearbyaircraft/backend/venv/bin"
ExecStart=/home/admin/nearbyaircraft/backend/venv/bin/gunicorn -w 4 -b 127.0.0.1:3001 app:app
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

